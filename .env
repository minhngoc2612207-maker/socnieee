# =====================================================================
# SOCONIE CRM - CẤU HÌNH MÔI TRƯỜNG BẢO MẬT & XÁC THỰC
# Chủ sở hữu: Lê Minh Ngọc · Quản trị bán hàng & CRM
# =====================================================================

# 1. BẢO MẬT PHIÊN & MẬT MÃ
CRM_SECRET_KEY=soconie_production_secret_session_key_2026_xyz

# 2. XÁC THỰC: BỎ OTP SMS, BẬT CAPTCHA KÉO GHÉP HÌNH
AUTH_OTP_ENABLED=false
CAPTCHA_PROVIDER=slider
CAPTCHA_TOLERANCE_PX=4
CAPTCHA_TTL_SECONDS=120
CAPTCHA_MAX_FAILS=5
CAPTCHA_LOCK_MINUTES=10

# 3. DỊCH VỤ EMAIL (KHÔI PHỤC MẬT KHẨU & CẢNH BÁO ĐĂNG NHẬP MỚI)
# Lựa chọn: console (mô phỏng, in terminal), smtp (Gmail), resend (Resend.com)
EMAIL_BACKEND=console
EMAIL_SENDER=Soconie CRM <minhngoc2612207@gmail.com>

# Nếu dùng Gmail SMTP (tạo Mật khẩu ứng dụng 16 ký tự tại myaccount.google.com/apppasswords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Nếu dùng Resend API (lấy khóa tại resend.com/api-keys):
RESEND_API_KEY=

# 4. SMS ADAPTER CŨ (TẮT MẶC ĐỊNH, ĐỂ DÀNH BẬT LẠI KHI CẦN)
# Để bật lại SMS OTP trong tương lai, chỉ cần đặt AUTH_OTP_ENABLED=true
SMS_PROVIDER=esms
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_BRANDNAME=Soconie
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_DAILY_LIMIT_PER_PHONE=5
OTP_DAILY_LIMIT_PER_IP=20
OTP_PEPPER=soconie_secret_pepper_random_key_change_me_in_production_2026
OTP_DEV_ECHO=false
