# =====================================================================
# SOCONIE CRM - FILE MẪU CẤU HÌNH MÔI TRƯỜNG (.env.example)
# Chủ sở hữu: Lê Minh Ngọc · Quản trị bán hàng & CRM
# Hotline: 0363 651 407 · Email: minhngoc2612207@gmail.com
# =====================================================================

# 1. BẢO MẬT PHIÊN & MẬT MÃ
CRM_SECRET_KEY=soconie_production_secret_session_key_2026_xyz

# 2. XÁC THỰC: BỎ OTP SMS, BẬT CAPTCHA KÉO GHÉP HÌNH
AUTH_OTP_ENABLED=false
CAPTCHA_PROVIDER=slider
CAPTCHA_TOLERANCE_PX=4
CAPTCHA_TTL_SECONDS=120
CAPTCHA_MAX_FAILS=5
CAPTCHA_LOCK_MINUTES=10

# 3. DỊCH VỤ EMAIL (KHÔI PHỤC MẬT KHẨU & CẢNH BÁO ĐĂNG NHẬP MỚI)
# Giá trị: console | smtp | resend
EMAIL_BACKEND=console
EMAIL_SENDER=Soconie CRM <minhngoc2612207@gmail.com>

# ---------------------------------------------------------------------
# HƯỚNG DẪN CẤU HÌNH GMAIL SMTP (MẬT KHẨU ỨNG DỤNG):
# 1. Truy cập tài khoản Google: https://myaccount.google.com/security
# 2. Bật Xác minh 2 bước (2-Step Verification) nếu chưa bật.
# 3. Vào "Mật khẩu ứng dụng" (App passwords): https://myaccount.google.com/apppasswords
# 4. Tạo một mật khẩu mới cho ứng dụng "Soconie CRM". Google sẽ cấp 1 mã 16 chữ cái (ví dụ: abcd efgh ijkl mnop).
# 5. Đặt EMAIL_BACKEND=smtp, điền email vào SMTP_USER và mã 16 chữ cái vào SMTP_PASS (không có dấu cách).
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------
# HƯỚNG DẪN CẤU HÌNH RESEND API:
# 1. Đăng ký tài khoản miễn phí tại: https://resend.com
# 2. Vào mục "API Keys" -> Tạo khóa mới (re_xxxxxxxx...)
# 3. Đặt EMAIL_BACKEND=resend, điền khóa vào RESEND_API_KEY.
# ---------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------
# 4. CẤU HÌNH SMS ADAPTER CŨ (TẮT MẶC ĐỊNH, ĐỂ DÀNH BẬT LẠI KHI CẦN)
# Khi muốn bật lại OTP qua tin nhắn SMS, chỉ cần đổi AUTH_OTP_ENABLED=true
# ---------------------------------------------------------------------
SMS_PROVIDER=esms
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_BRANDNAME=Soconie
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_DAILY_LIMIT_PER_PHONE=5
OTP_DAILY_LIMIT_PER_IP=20
OTP_PEPPER=soconie_secret_pepper_random_key_change_me_in_production_2026
OTP_DEV_ECHO=false
